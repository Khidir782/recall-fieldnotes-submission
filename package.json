{
  "name": "recall-fieldnotes-submission",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src server functions workers scripts tests package.json index.html",
    "format:check": "prettier --check src server functions workers scripts tests package.json index.html",
    "dev:cloudflare": "wrangler pages dev dist",
    "db:local": "wrangler d1 migrations apply DB --local",
    "check:cloudflare": "wrangler pages functions build --outdir /private/tmp/recall-functions"
  },
  "dependencies": {
    "jose": "^6.2.17",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.8",
    "miniflare": "^5.20261113.0-beta",
    "prettier": "^3.10.1",
    "react-test-renderer": "^19.3.1",
    "vite": "^6.0.0",
    "wrangler": "^4.162.0"
  }
}
